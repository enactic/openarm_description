<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm">
  <xacro:include filename="$(find openarm_description)/assets/common/assembly.xacro" />
  <xacro:include filename="$(find openarm_description)/assets/common/ros2_control.xacro" />

  <xacro:arg name="arm_type" default="v10" />
  <xacro:arg name="body_type" default="v10" />
  <xacro:arg name="robot_preset" default="" />
  <xacro:arg name="bimanual" default="true" />
  <xacro:arg name="no_prefix" default="false" />
  <xacro:arg name="parent" default="" />
  <xacro:arg name="xyz" default="" />
  <xacro:arg name="rpy" default="" />
  <xacro:arg name="right_arm_base_xyz" default="" />
  <xacro:arg name="right_arm_base_rpy" default="" />
  <xacro:arg name="left_arm_base_xyz" default="" />
  <xacro:arg name="left_arm_base_rpy" default="" />
  <xacro:arg name="left_arm_prefix" default="" />
  <xacro:arg name="right_arm_prefix" default="" />
  <xacro:arg name="ros2_control" default="false" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="fake_sensor_commands" default="false" />
  <xacro:arg name="can_interface" default="can0" />
  <xacro:arg name="left_can_interface" default="can1" />
  <xacro:arg name="right_can_interface" default="can0" />
  <xacro:arg name="can_fd" default="true" />

  <xacro:openarm_require condition="${'$(arg arm_type)' in ['v10', 'v1.0', 'v1_0', 'openarm_v10', 'openarm_v1.0', 'openarm_v1_0']}" message="V1 entry requires arm_type:=v10." />
  <xacro:openarm_require condition="${'$(arg body_type)' == 'v10'}" message="V1 entry requires body_type:=v10." />
  <xacro:property name="config_root" value="$(find openarm_description)/assets/robot/openarm_v1.0/config" />
  <xacro:property name="preset_name" value="${'$(arg robot_preset)' or ('default_bimanual' if '$(arg bimanual)'.lower() in ['true', '1'] else 'default_single')}" />
  <xacro:property name="preset" value="${xacro.load_yaml(config_root + '/robot_presets/' + preset_name + '.yaml')}" lazy_eval="false" />
  <xacro:property name="without_prefix" value="${'$(arg no_prefix)'.lower() in ['true', '1']}" />
  <xacro:property name="arm_count" value="${len([n for n in preset['robot']['components'] if preset[n]['enabled'] and preset[n]['type'] == 'robot' and preset[n]['config'] == 'arm'])}" />
  <xacro:property name="body_mounts" value="${xacro.load_yaml(config_root + '/body/struct/reference_points.yaml')}" />

  <xacro:macro name="openarm_v1_entry_components" params="value index:=0 out_name">
    <xacro:property name="names" value="${value['robot']['components']}" />
    <xacro:if value="${index &lt; len(names)}">
      <xacro:property name="name" value="${names[index]}" />
      <xacro:property name="component" value="${value[name]}" lazy_eval="false" />
      <xacro:property name="connection" value="${component.get('connection', dict())}" lazy_eval="false" />
      <xacro:if value="${without_prefix and component['type'] == 'robot' and component['config'] == 'body'}">
        <xacro:property name="component" value="${dict(component, link_name='body_link0')}" lazy_eval="false" />
      </xacro:if>
      <xacro:if value="${without_prefix and arm_count == 1 and (component['type'] == 'end_effector' or (component['type'] == 'robot' and component['config'] == 'arm'))}">
        <xacro:property name="component" value="${dict(component, prefix='')}" lazy_eval="false" />
      </xacro:if>
      <xacro:if value="${not connection.get('attach_to') and '$(arg parent)' != ''}">
        <xacro:property name="connection" value="${dict(connection, parent='$(arg parent)')}" lazy_eval="false" />
      </xacro:if>
      <xacro:if value="${not connection.get('attach_to') and ('$(arg xyz)' != '' or '$(arg rpy)' != '')}">
        <xacro:property name="base" value="${connection.get('origin') or dict(x=0, y=0, z=0, roll=0, pitch=0, yaw=0)}" />
        <xacro:property name="pos" value="${[float(v) for v in '$(arg xyz)'.split()] if '$(arg xyz)' else [base['x'], base['y'], base['z']]}" />
        <xacro:property name="rot" value="${[float(v) for v in '$(arg rpy)'.split()] if '$(arg rpy)' else [base['roll'], base['pitch'], base['yaw']]}" />
        <xacro:property name="connection" value="${dict(connection, origin=dict(x=pos[0], y=pos[1], z=pos[2], roll=rot[0], pitch=rot[1], yaw=rot[2]))}" lazy_eval="false" />
      </xacro:if>
      <xacro:if value="${component['type'] == 'robot' and component['config'] == 'arm' and connection.get('attach_to') not in [None, '']}">
        <xacro:property name="side" value="${component['control']['side']}" />
        <xacro:property name="position_arg" value="${'$(arg left_arm_base_xyz)' if side == 'left' else '$(arg right_arm_base_xyz)'}" />
        <xacro:property name="rotation_arg" value="${'$(arg left_arm_base_rpy)' if side == 'left' else '$(arg right_arm_base_rpy)'}" />
        <xacro:if value="${position_arg != '' or rotation_arg != ''}">
          <xacro:property name="base" value="${body_mounts[connection['parent_reference_point']]['origin'] if connection.get('parent_reference_point') else connection['origin']}" />
          <xacro:property name="pos" value="${[float(v) for v in position_arg.split()] if position_arg else [base['x'], base['y'], base['z']]}" />
          <xacro:property name="rot" value="${[float(v) for v in rotation_arg.split()] if rotation_arg else [base['roll'], base['pitch'], base['yaw']]}" />
          <xacro:property name="connection" value="${dict(connection, parent_reference_point=None, parent=None, origin=dict(x=pos[0], y=pos[1], z=pos[2], roll=rot[0], pitch=rot[1], yaw=rot[2]))}" lazy_eval="false" />
        </xacro:if>
        <xacro:property name="prefix_arg" value="${'$(arg left_arm_prefix)' if side == 'left' else '$(arg right_arm_prefix)'}" />
        <xacro:if value="${prefix_arg != ''}">
          <xacro:property name="component" value="${dict(component, prefix='openarm_' + prefix_arg)}" lazy_eval="false" />
        </xacro:if>
      </xacro:if>
      <xacro:if value="${component['type'] == 'end_effector' and arm_count > 1}">
        <xacro:property name="side" value="${value[connection['attach_to']]['control']['side']}" />
        <xacro:property name="prefix_arg" value="${'$(arg left_arm_prefix)' if side == 'left' else '$(arg right_arm_prefix)'}" />
        <xacro:if value="${prefix_arg != ''}"><xacro:property name="component" value="${dict(component, prefix='openarm_' + prefix_arg)}" lazy_eval="false" /></xacro:if>
      </xacro:if>
      <xacro:property name="updated" value="${dict(list(value.items()) + [(name, dict(component, connection=connection))])}" lazy_eval="false" />
      <xacro:openarm_v1_entry_components value="${updated}" index="${index + 1}" out_name="updated" />
      <xacro:property name="${out_name}" value="${updated}" scope="parent" lazy_eval="false" />
    </xacro:if>
    <xacro:unless value="${index &lt; len(names)}"><xacro:property name="${out_name}" value="${value}" scope="parent" lazy_eval="false" /></xacro:unless>
  </xacro:macro>
  <xacro:openarm_v1_entry_components value="${preset}" out_name="preset" />
  <xacro:if value="${'$(arg parent)' != ''}">
    <xacro:property name="preset" value="${dict(preset, robot=dict(preset['robot'], root_frame='$(arg parent)'))}" lazy_eval="false" />
  </xacro:if>
  <xacro:openarm_assemble_robot config_root="${config_root}" robot_preset="${preset}" />
  <xacro:if value="$(arg ros2_control)">
    <xacro:openarm_ros2_control robot_preset="${preset}" config_root="${config_root}" arm_type="v10"
      can_interfaces="${dict(single='$(arg can_interface)', left='$(arg left_can_interface)', right='$(arg right_can_interface)')}"
      use_fake_hardware="$(arg use_fake_hardware)" fake_sensor_commands="$(arg fake_sensor_commands)" can_fd="$(arg can_fd)" />
  </xacro:if>
</robot>
