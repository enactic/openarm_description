<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v2.0/urdf/ros2_control/openarm.ros2_control.xacro" />

  <xacro:macro name="openarm_v20_ros2_control"
    params="robot_preset config_root can_interfaces use_fake_hardware:=true fake_sensor_commands:=false can_fd:=true index:=0">
    <xacro:property name="components" value="${robot_preset['robot']['components']}" lazy_eval="false" />
    <xacro:if value="${index &lt; len(components)}">
      <xacro:property name="name" value="${components[index]}" lazy_eval="false" />
      <xacro:property name="component" value="${robot_preset[name]}" lazy_eval="false" />
      <xacro:if value="${component['enabled'] and component['type'] == 'robot' and component['config'] == 'arm'}">
        <xacro:property name="side" value="${component['control']['side']}" lazy_eval="false" />
        <xacro:openarm_v20_require condition="${side in can_interfaces}" message="${'Unknown control side `%s` on `%s`.' % (side, name)}" />
        <xacro:property name="controlled_arms" value="${[c for c in components if robot_preset[c]['enabled'] and robot_preset[c]['type'] == 'robot' and robot_preset[c]['config'] == 'arm']}" lazy_eval="false" />
        <xacro:openarm_v20_require condition="${len([c for c in controlled_arms if robot_preset[c]['control']['side'] == side]) == 1}" message="${'Multiple arms select the `%s` hardware interface.' % side}" />
        <xacro:property name="prefix" value="${component.get('prefix', '')}" lazy_eval="false" />
        <xacro:property name="arm_topology" value="${xacro.load_yaml(config_root + '/arm/struct/topology.yaml')}" lazy_eval="false" />
        <xacro:property name="control_gains" value="${xacro.load_yaml(config_root + '/arm/control/control_gains.yaml')}" lazy_eval="false" />
        <xacro:property name="joint_names" value="${[prefix + joint for joint in arm_topology['joints'] if arm_topology['joints'][joint]['type'] != 'fixed']}" lazy_eval="false" />
        <xacro:property name="grippers" value="${[c for c in components if robot_preset[c]['enabled'] and robot_preset[c]['type'] == 'end_effector' and robot_preset[c].get('connection', dict()).get('attach_to') == name]}" lazy_eval="false" />
        <xacro:openarm_v20_require condition="${len(grippers) &lt;= 1}" message="${'Arm `%s` supports one controlled gripper.' % name}" />
        <xacro:property name="ee_type" value="${''}" lazy_eval="false" />
        <xacro:if value="${len(grippers) == 1}">
          <xacro:property name="gripper" value="${robot_preset[grippers[0]]}" lazy_eval="false" />
          <xacro:property name="ee_type" value="${gripper['product']}" lazy_eval="false" />
          <xacro:property name="gripper_root" value="${'$(find openarm_description)/assets/end_effector/' + ee_type + '/config'}" lazy_eval="false" />
          <xacro:property name="gripper_topology" value="${xacro.load_yaml(gripper_root + '/struct/topology.yaml')}" lazy_eval="false" />
          <xacro:property name="gripper_mimics" value="${xacro.load_yaml(gripper_root + '/joint/joint_mimics.yaml')}" lazy_eval="false" />
          <xacro:property name="gripper_prefix" value="${gripper.get('prefix', '')}" lazy_eval="false" />
          <xacro:property name="joint_names" value="${joint_names + [gripper_prefix + 'finger_' + joint for joint in gripper_topology['joints'] if gripper_topology['joints'][joint]['type'] != 'fixed' and joint not in gripper_mimics]}" lazy_eval="false" />
        </xacro:if>
        <xacro:openarm_v20_arm_ros2_control
          system_name="${'openarm_' + side + '_hardware_interface'}" joint_names="${joint_names}"
          hardware_prefix="${prefix[8:] if prefix.startswith('openarm_') else prefix}"
          can_interface="${can_interfaces[side]}" control_gains="${control_gains}" ee_type="${ee_type}"
          use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}" can_fd="${can_fd}" />
      </xacro:if>
      <xacro:openarm_v20_ros2_control robot_preset="${robot_preset}" config_root="${config_root}" can_interfaces="${can_interfaces}"
        use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}" can_fd="${can_fd}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>
</robot>
