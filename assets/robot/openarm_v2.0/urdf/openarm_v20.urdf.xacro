<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_v20">

  <xacro:include filename="$(find openarm_description)/assets/component_loader.xacro" />

  <xacro:include filename="$(find openarm_description)/assets/common/ros2_control.xacro" />

  <xacro:arg name="robot_preset" default="default_bimanual" />
  <xacro:arg name="emit_grasp_frame" default="false" />

  <xacro:arg name="ros2_control" default="true" />
  <xacro:arg name="fake_sensor_commands" default="false" />
  <xacro:arg name="use_fake_hardware" default="true" />
  <xacro:arg name="left_can_interface" default="can1" />
  <xacro:arg name="right_can_interface" default="can0" />
  <xacro:arg name="can_fd" default="true" />

  <xacro:property name="robot_root" value="$(find openarm_description)/assets/robot/openarm_v2.0" />
  <xacro:property name="config_root" value="${robot_root + '/config'}" />
  <xacro:property name="robot_preset_cfg" value="${xacro.load_yaml(config_root + '/robot_presets/' + '$(arg robot_preset)' + '.yaml')}" />

  <xacro:openarm_assemble_robot component_api="${dict(describe='openarm_describe_auto_component', emit='openarm_emit_auto_component')}"
    config_root="${config_root}"
    robot_preset="${robot_preset_cfg}"
    emit_grasp_frame="$(arg emit_grasp_frame)" />

  <xacro:if value="$(arg ros2_control)">
    <xacro:openarm_ros2_control robot_preset="${robot_preset_cfg}" config_root="${config_root}"
      can_interfaces="${dict(left='$(arg left_can_interface)', right='$(arg right_can_interface)')}"
      use_fake_hardware="$(arg use_fake_hardware)" fake_sensor_commands="$(arg fake_sensor_commands)" can_fd="$(arg can_fd)" />
  </xacro:if>

</robot>
