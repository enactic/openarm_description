<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pinch_gripper">



  <xacro:include filename="$(find openarm_description)/assets/component_loader.xacro" />
  <xacro:arg name="ee_config_dir" default="$(find openarm_description)/assets/end_effector/pinch_gripper/config" />
  <xacro:arg name="ee_inertials_name" default="nominal" />
  <xacro:arg name="reflect_x" default="1" />
  <xacro:arg name="reflect_y" default="1" />
  <xacro:arg name="reflect_z" default="1" />
  <xacro:arg name="emit_grasp_frame" default="false" />

  <xacro:property name="reflect_x_value" value="${float('$(arg reflect_x)')}" lazy_eval="false" />
  <xacro:property name="reflect_y_value" value="${float('$(arg reflect_y)')}" lazy_eval="false" />
  <xacro:property name="reflect_z_value" value="${float('$(arg reflect_z)')}" lazy_eval="false" />

  <xacro:property name="options" value="${dict(emit_grasp_frame='$(arg emit_grasp_frame)'.lower() in ['true', '1'])}" />
  <xacro:property name="component_cfg"
    value="${dict(type='end_effector', product='pinch_gripper', config=None, inertials='$(arg ee_inertials_name)', prefix='', enabled=True, reflect=dict(x=reflect_x_value, y=reflect_y_value, z=reflect_z_value))}" />
  <xacro:openarm_describe_auto_component component_name="gripper" component_cfg="${component_cfg}" options="${options}"
    config_root_override="$(arg ee_config_dir)" out_name="description" />
  <xacro:openarm_emit_standalone_component component_cfg="${component_cfg}" component_desc="${description}" options="${options}" />
</robot>
