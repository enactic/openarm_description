<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="describe_component" params="component_name component_cfg config_root options out_name">
    <xacro:openarm_describe_config_component component_name="${component_name}" component_cfg="${component_cfg}" config_root="${config_root}" options="${options}" out_name="description" />
    <xacro:if value="${options.get('emit_grasp_frame', False) and 'grasp_frame' in description['reference_points']}">
      <xacro:property name="references" value="${description['reference_points']}" />
      <xacro:property name="references" value="${dict(references, grasp_frame=dict(references['grasp_frame'], emit=True))}" lazy_eval="false" />
      <xacro:property name="description" value="${dict(description, reference_points=references)}" lazy_eval="false" />
    </xacro:if>
    <xacro:property name="${out_name}" value="${description}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="emit_component" params="component_desc component_runtime options">
    <xacro:include filename="${component_desc['component_dir'] + '/urdf/pinch_gripper_macro.xacro'}" />
    <xacro:openarm_pinch_gripper
      prefix="${component_desc['prefix']}"
      connected_to="${component_runtime['resolved_connected_to']}"
      mount_origin="${component_runtime['resolved_mount_origin']}"
      topology="${component_desc['topology']}"
      ee_reference_points="${component_desc['reference_points']}"
      joint_origins="${component_desc['joint_origins']}"
      joint_axes="${component_desc['joint_axes']}"
      joint_limits="${component_desc['joint_limits']}"
      joint_mimics="${component_desc['joint_mimics']}"
      inertials="${component_desc['inertials']}"
      visuals="${component_desc['visuals']}"
      collisions="${component_desc['collisions']}"
      reflect_x="${component_runtime['reflect_x']}"
      reflect_y="${component_runtime['reflect_y']}"
      reflect_z="${component_runtime['reflect_z']}"
      component_reflects="${component_runtime['component_reflects']}"
      reflect_include_links="${component_runtime['reflect_include_links']}"
      reflect_include_joints="${component_runtime['reflect_include_joints']}"
      reflect_include_reference_points="${component_runtime['reflect_include_reference_points']}"
      origin_override_joints="${component_runtime['origin_override_joints']}"
      limit_override_joints="${component_runtime['limit_override_joints']}"
      emit_grasp_frame="${options.get('emit_grasp_frame', False)}"
      skip_mount_joint="${component_runtime['skip_mount_joint']}"
      base_frame_shift="${component_runtime['base_frame_shift']}" />
  </xacro:macro>
</robot>
