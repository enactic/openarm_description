<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find openarm_description)/assets/common/links.xacro" />
  <xacro:include filename="$(find openarm_description)/assets/common/reference_frames.xacro" />
  <xacro:include filename="$(find openarm_description)/assets/common/validation.xacro" />

  <xacro:macro name="openarm_pinch_gripper"
    params="prefix connected_to mount_origin:=none topology joint_origins joint_axes joint_limits joint_mimics inertials visuals collisions reflect_x:=1 reflect_y:=1 reflect_z:=1 component_reflects:=false reflect_include_links:=^ reflect_include_joints:=^ reflect_include_reference_points:=^ origin_override_joints:=${dict()} limit_override_joints:=^ ee_reference_points:=^ emit_grasp_frame:=false grasp_reference_point:=grasp_frame skip_mount_joint:=false base_frame_shift:=none">

    <xacro:property name="base_link_name" value="${topology['links'][0]}" />


    <xacro:property name="base_link_full_name" value="${prefix}${base_link_name}" />
    <xacro:property name="resolved_mount_origin" value="${mount_origin if mount_origin != 'none' else dict(x=0.0, y=0.0, z=0.0, roll=0.0, pitch=0.0, yaw=0.0)}" lazy_eval="false" />
    <xacro:property name="resolved_base_frame_shift" value="${base_frame_shift if base_frame_shift != 'none' else dict(x=0.0, y=0.0, z=0.0, roll=0.0, pitch=0.0, yaw=0.0)}" lazy_eval="false" />
    <xacro:property name="use_base_frame_shift" value="${base_frame_shift != 'none'}" lazy_eval="false" />
    <xacro:property name="base_link_reflects" value="${component_reflects and base_link_name in reflect_include_links}" lazy_eval="false" />
    <!-- Finger numbering stays semantic; handedness is handled by reflect_* and the joint config. -->
    <xacro:property name="finger1_source" value="${topology['joints']['finger_joint1']['child']}" />
    <xacro:property name="finger2_source" value="${topology['joints']['finger_joint2']['child']}" />
    <xacro:property name="finger1_joint_source" value="finger_joint1" />
    <xacro:property name="finger2_joint_source" value="finger_joint2" />
    <xacro:property name="finger1_link_reflects" value="${component_reflects and finger1_source in reflect_include_links}" lazy_eval="false" />
    <xacro:property name="finger2_link_reflects" value="${component_reflects and finger2_source in reflect_include_links}" lazy_eval="false" />
    <xacro:property name="finger1_joint_reflects" value="${component_reflects and finger1_joint_source in reflect_include_joints}" lazy_eval="false" />
    <xacro:property name="finger2_joint_reflects" value="${component_reflects and finger2_joint_source in reflect_include_joints}" lazy_eval="false" />
    <xacro:property name="finger1_has_mimic" value="${finger1_joint_source in joint_mimics}" />
    <xacro:property name="finger2_has_mimic" value="${finger2_joint_source in joint_mimics}" />
    <xacro:property name="finger1_mimic_target_source" value="${joint_mimics[finger1_joint_source]['joint'] if finger1_has_mimic else ''}" />
    <xacro:property name="finger2_mimic_target_source" value="${joint_mimics[finger2_joint_source]['joint'] if finger2_has_mimic else ''}" />
    <xacro:property name="finger1_mimic_target_name" value="${prefix + finger1_mimic_target_source}" />
    <xacro:property name="finger2_mimic_target_name" value="${prefix + finger2_mimic_target_source}" />
    <xacro:property name="finger1_mimic_override" value="${dict(joint=finger1_mimic_target_name, multiplier=joint_mimics[finger1_joint_source]['multiplier'], offset=joint_mimics[finger1_joint_source]['offset']) if finger1_has_mimic else 'none'}" />
    <xacro:property name="finger2_mimic_override" value="${dict(joint=finger2_mimic_target_name, multiplier=joint_mimics[finger2_joint_source]['multiplier'], offset=joint_mimics[finger2_joint_source]['offset']) if finger2_has_mimic else 'none'}" />
    <xacro:openarm_emit_link
      link_name="${base_link_full_name}" source_name="${base_link_name}"
      inertials="${inertials}" visuals="${visuals}" collisions="${collisions}"
      reflect_x="${reflect_x if base_link_reflects else 1}"
      reflect_y="${reflect_y if base_link_reflects else 1}"
      reflect_z="${reflect_z if base_link_reflects else 1}"
      frame_shift="${base_frame_shift}" />

    <xacro:openarm_emit_link
      link_name="${prefix}${finger1_source}"
      source_name="${finger1_source}"
      inertials="${inertials}"
      visuals="${visuals}"
      collisions="${collisions}"
      reflect_x="${reflect_x if finger1_link_reflects else 1}"
      reflect_y="${reflect_y if finger1_link_reflects else 1}"
      reflect_z="${reflect_z if finger1_link_reflects else 1}" />

    <xacro:openarm_emit_link
      link_name="${prefix}${finger2_source}"
      source_name="${finger2_source}"
      inertials="${inertials}"
      visuals="${visuals}"
      collisions="${collisions}"
      reflect_x="${reflect_x if finger2_link_reflects else 1}"
      reflect_y="${reflect_y if finger2_link_reflects else 1}"
      reflect_z="${reflect_z if finger2_link_reflects else 1}" />

    <xacro:unless value="${skip_mount_joint}">
      <joint name="${base_link_full_name}_mount_joint" type="fixed">
        <xacro:openarm_emit_origin origin="${resolved_mount_origin}" />
        <parent link="${connected_to}" />
        <child link="${base_link_full_name}" />
      </joint>
    </xacro:unless>

    <!-- Finger joints are emitted explicitly so mimic remapping stays local to the EE emitter. -->
    <xacro:property name="finger1_joint_origin_cfg" value="${origin_override_joints.get(finger1_joint_source, joint_origins[finger1_joint_source]['origin'])}" lazy_eval="false" />
    <xacro:property name="finger2_joint_origin_cfg" value="${origin_override_joints.get(finger2_joint_source, joint_origins[finger2_joint_source]['origin'])}" lazy_eval="false" />
    <xacro:property name="finger1_joint_axis_cfg" value="${joint_axes[finger1_joint_source]['axis']}" lazy_eval="false" />
    <xacro:property name="finger2_joint_axis_cfg" value="${joint_axes[finger2_joint_source]['axis']}" lazy_eval="false" />
    <xacro:property
      name="finger1_joint_axis_reflect_sign"
      value="${-1 if finger1_joint_reflects and ((reflect_x == -1 and finger1_joint_axis_cfg.x * finger1_joint_axis_cfg.x > 1e-18) or (reflect_y == -1 and finger1_joint_axis_cfg.y * finger1_joint_axis_cfg.y > 1e-18) or (reflect_z == -1 and finger1_joint_axis_cfg.z * finger1_joint_axis_cfg.z > 1e-18)) else 1}"
      lazy_eval="false" />
    <xacro:property
      name="finger2_joint_axis_reflect_sign"
      value="${-1 if finger2_joint_reflects and ((reflect_x == -1 and finger2_joint_axis_cfg.x * finger2_joint_axis_cfg.x > 1e-18) or (reflect_y == -1 and finger2_joint_axis_cfg.y * finger2_joint_axis_cfg.y > 1e-18) or (reflect_z == -1 and finger2_joint_axis_cfg.z * finger2_joint_axis_cfg.z > 1e-18)) else 1}"
      lazy_eval="false" />
    <xacro:property name="finger1_joint_limit_cfg" value="${joint_limits[finger1_joint_source]['limit']}" lazy_eval="false" />
    <xacro:property name="finger2_joint_limit_cfg" value="${joint_limits[finger2_joint_source]['limit']}" lazy_eval="false" />
    <xacro:property
      name="finger1_limit_should_mirror"
      value="${finger1_joint_reflects}"
      lazy_eval="false" />
    <xacro:property
      name="finger2_limit_should_mirror"
      value="${finger2_joint_reflects}"
      lazy_eval="false" />
    <xacro:property
      name="finger1_joint_limit_override"
      value="${limit_override_joints.get(finger1_joint_source, 'none')}"
      lazy_eval="false" />
    <xacro:property
      name="finger2_joint_limit_override"
      value="${limit_override_joints.get(finger2_joint_source, 'none')}"
      lazy_eval="false" />
    <xacro:property name="finger1_joint_limit_base" value="${finger1_joint_limit_override if finger1_joint_limit_override != 'none' else finger1_joint_limit_cfg}" lazy_eval="false" />
    <xacro:property
      name="finger1_joint_limit_effective"
      value="${dict(lower=(-finger1_joint_limit_base['upper']), upper=(-finger1_joint_limit_base['lower']), effort=finger1_joint_limit_base['effort'], velocity=finger1_joint_limit_base['velocity']) if finger1_limit_should_mirror else finger1_joint_limit_base}"
      lazy_eval="false" />
    <xacro:property name="finger2_joint_limit_base" value="${finger2_joint_limit_override if finger2_joint_limit_override != 'none' else finger2_joint_limit_cfg}" lazy_eval="false" />
    <xacro:property
      name="finger2_joint_limit_effective"
      value="${dict(lower=(-finger2_joint_limit_base['upper']), upper=(-finger2_joint_limit_base['lower']), effort=finger2_joint_limit_base['effort'], velocity=finger2_joint_limit_base['velocity']) if finger2_limit_should_mirror else finger2_joint_limit_base}"
      lazy_eval="false" />

    <joint name="${prefix}${finger1_joint_source}" type="${topology['joints'][finger1_joint_source]['type']}">
      <xacro:if value="${use_base_frame_shift}">
        <xacro:openarm_emit_shifted_origin frame_shift="${resolved_base_frame_shift}" origin="${finger1_joint_origin_cfg}" reflect_x="${reflect_x if finger1_joint_reflects else 1}" reflect_y="${reflect_y if finger1_joint_reflects else 1}" reflect_z="${reflect_z if finger1_joint_reflects else 1}" reflect_rotation="${True}" />
      </xacro:if>
      <xacro:unless value="${use_base_frame_shift}">
        <xacro:openarm_emit_origin origin="${finger1_joint_origin_cfg}" reflect_x="${reflect_x if finger1_joint_reflects else 1}" reflect_y="${reflect_y if finger1_joint_reflects else 1}" reflect_z="${reflect_z if finger1_joint_reflects else 1}" reflect_rotation="${True}" />
      </xacro:unless>
      <parent link="${prefix}${topology['joints'][finger1_joint_source]['parent']}" />
      <child link="${prefix}${finger1_source}" />
      <xacro:if value="${topology['joints'][finger1_joint_source]['type'] != 'fixed'}">
      <axis xyz="${finger1_joint_axis_reflect_sign * finger1_joint_axis_cfg.x} ${finger1_joint_axis_reflect_sign * finger1_joint_axis_cfg.y} ${finger1_joint_axis_reflect_sign * finger1_joint_axis_cfg.z}" />
      <xacro:openarm_emit_limit limit="${finger1_joint_limit_effective}" />
      <xacro:if value="${finger1_mimic_override != 'none'}">
        <mimic
          joint="${finger1_mimic_override['joint']}"
          multiplier="${finger1_mimic_override['multiplier']}"
          offset="${finger1_mimic_override['offset']}" />
      </xacro:if>
          </xacro:if>
    </joint>

    <joint name="${prefix}${finger2_joint_source}" type="${topology['joints'][finger2_joint_source]['type']}">
      <xacro:if value="${use_base_frame_shift}">
        <xacro:openarm_emit_shifted_origin frame_shift="${resolved_base_frame_shift}" origin="${finger2_joint_origin_cfg}" reflect_x="${reflect_x if finger2_joint_reflects else 1}" reflect_y="${reflect_y if finger2_joint_reflects else 1}" reflect_z="${reflect_z if finger2_joint_reflects else 1}" reflect_rotation="${True}" />
      </xacro:if>
      <xacro:unless value="${use_base_frame_shift}">
        <xacro:openarm_emit_origin origin="${finger2_joint_origin_cfg}" reflect_x="${reflect_x if finger2_joint_reflects else 1}" reflect_y="${reflect_y if finger2_joint_reflects else 1}" reflect_z="${reflect_z if finger2_joint_reflects else 1}" reflect_rotation="${True}" />
      </xacro:unless>
      <parent link="${prefix}${topology['joints'][finger2_joint_source]['parent']}" />
      <child link="${prefix}${finger2_source}" />
      <xacro:if value="${topology['joints'][finger2_joint_source]['type'] != 'fixed'}">
      <axis xyz="${finger2_joint_axis_reflect_sign * finger2_joint_axis_cfg.x} ${finger2_joint_axis_reflect_sign * finger2_joint_axis_cfg.y} ${finger2_joint_axis_reflect_sign * finger2_joint_axis_cfg.z}" />
      <xacro:openarm_emit_limit limit="${finger2_joint_limit_effective}" />
      <xacro:if value="${finger2_mimic_override != 'none'}">
        <mimic
          joint="${finger2_mimic_override['joint']}"
          multiplier="${finger2_mimic_override['multiplier']}"
          offset="${finger2_mimic_override['offset']}" />
      </xacro:if>
          </xacro:if>
    </joint>

    <xacro:openarm_emit_reference_frames
      reference_points="${ee_reference_points}"
      force_emit_reference="${grasp_reference_point if emit_grasp_frame else ''}"
      prefix="${prefix}"
      base_link_name="${base_link_name}"
      reflect_x="${reflect_x if component_reflects else 1}"
      reflect_y="${reflect_y if component_reflects else 1}"
      reflect_z="${reflect_z if component_reflects else 1}"
      reflect_include_reference_points="${reflect_include_reference_points}"
      frame_shift="${resolved_base_frame_shift if use_base_frame_shift else 'none'}" />
  </xacro:macro>

</robot>
