<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The right hand of the official LinkerHand O6 description. -->
  <xacro:macro name="describe_component" params="component_name component_cfg config_root options out_name">
    <xacro:include filename="$(find openarm_description)/assets/end_effector/linkerhand_o6/urdf_wrapper/openarm_linkerhand_o6_wrapper.xacro" />
    <xacro:openarm_describe_linkerhand_o6 component_name="${component_name}" component_cfg="${component_cfg}" side="right" out_name="description" />
    <xacro:property name="${out_name}" value="${description}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="emit_component" params="component_desc component_runtime options">
    <xacro:include filename="$(find openarm_description)/assets/end_effector/linkerhand_o6/urdf_wrapper/openarm_linkerhand_o6_wrapper.xacro" />
    <xacro:openarm_linkerhand_o6_wrapper
      side="right"
      root_link="${component_desc['root_link_actual']}"
      connected_to="${component_runtime['resolved_connected_to']}"
      mount_origin="${component_runtime['resolved_mount_origin']}" />
  </xacro:macro>
</robot>
