<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parallel_link">

  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/ee/openarm_ee_macro.xacro" />
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/ee/parallel_link/openarm_parallel_gripper.xacro" />

  <xacro:arg name="ee_config_dir" default="$(find openarm_description)/assets/end_effector/parallel_link/config" />
  <xacro:arg name="mesh_root" default="$(find openarm_description)/assets/end_effector/parallel_link/meshes" />
  <xacro:arg name="tcp_xyz" default="0 0 0.0835" />
  <xacro:arg name="tcp_rpy" default="0 0 0" />

  <link name="base_link" />
  <xacro:openarm_parallel_gripper
    connected_to="base_link"
    arm_type=""
    ee_type="parallel_link"
    no_prefix="true"
    mesh_root="$(arg mesh_root)"
    tcp_xyz="$(arg tcp_xyz)"
    tcp_rpy="$(arg tcp_rpy)"
    ee_inertials="${xacro.load_yaml('$(arg ee_config_dir)/inertials.yaml')}"
    ee_kinematics="${xacro.load_yaml('$(arg ee_config_dir)/kinematics.yaml')}"
    ee_kinematics_link="${xacro.load_yaml('$(arg ee_config_dir)/kinematics_link.yaml')}"
    ee_joints_limits="${xacro.load_yaml('$(arg ee_config_dir)/joint_limits.yaml')}" />

</robot>
