<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parallel_link">
  <xacro:include filename="$(find openarm_description)/assets/common/kinematic_chain.xacro" />
  <xacro:include filename="$(find openarm_description)/assets/common/reference_frames.xacro" />
  <xacro:arg name="ee_config_dir" default="$(find openarm_description)/assets/end_effector/parallel_link/config" />
  <xacro:arg name="mesh_root" default="" />
  <xacro:arg name="reflect_y" default="1" />
  <xacro:arg name="tcp_xyz" default="0 0 0.09" />
  <xacro:arg name="tcp_rpy" default="0 0 0" />
  <xacro:property name="topology" value="${xacro.load_yaml('$(arg ee_config_dir)/struct/topology.yaml')}" />
  <xacro:property name="references" value="${xacro.load_yaml('$(arg ee_config_dir)/struct/reference_points.yaml')}" />
  <xacro:property name="pos" value="${[float(v) for v in '$(arg tcp_xyz)'.split()]}" />
  <xacro:property name="rot" value="${[float(v) for v in '$(arg tcp_rpy)'.split()]}" />
  <xacro:property name="references" value="${dict(references, hand_tcp=dict(references['hand_tcp'], origin=dict(x=pos[0], y=pos[1], z=pos[2], roll=rot[0], pitch=rot[1], yaw=rot[2])))}" lazy_eval="false" />
  <xacro:property name="visuals" value="${xacro.load_yaml('$(arg ee_config_dir)/link/visuals.yaml')}" />
  <xacro:property name="collisions" value="${xacro.load_yaml('$(arg ee_config_dir)/link/collisions.yaml')}" />
  <xacro:if value="${'$(arg mesh_root)' != ''}">
    <xacro:property name="visuals" value="${dict([(name, dict(visuals[name], geometry=dict(visuals[name]['geometry'], mesh='$(arg mesh_root)/visual/' + visuals[name]['geometry']['mesh'].split('/')[-1]))) for name in visuals])}" lazy_eval="false" />
    <xacro:property name="collisions" value="${dict([(name, dict(collisions[name], geometry=dict(collisions[name]['geometry'], mesh='$(arg mesh_root)/collision/' + collisions[name]['geometry']['mesh'].split('/')[-1]))) for name in collisions])}" lazy_eval="false" />
  </xacro:if>
  <xacro:property name="reflect_y" value="${float('$(arg reflect_y)')}" />
  <xacro:openarm_require condition="${reflect_y in [-1, 1]}" message="reflect_y must be 1 or -1." />
  <link name="world" />
  <xacro:openarm_emit_kinematic_component connected_to="world" mount_origin="${dict(x=0, y=0, z=0, roll=0, pitch=0, yaw=0)}"
    topology="${topology}" link_prefix="" joint_prefix=""
    joint_origins="${xacro.load_yaml('$(arg ee_config_dir)/joint/joint_origins.yaml')}"
    joint_axes="${xacro.load_yaml('$(arg ee_config_dir)/joint/joint_axes.yaml')}"
    joint_limits="${xacro.load_yaml('$(arg ee_config_dir)/joint/joint_limits.yaml')}"
    joint_mimics="${xacro.load_yaml('$(arg ee_config_dir)/joint/joint_mimics.yaml')}"
    inertials="${xacro.load_yaml('$(arg ee_config_dir)/inertials/nominal.yaml')}" visuals="${visuals}" collisions="${collisions}"
    reflect_y="${reflect_y}" reflect_include_links="${['link7']}" reflect_include_joints="${[]}" />
  <xacro:openarm_emit_reference_frames reference_points="${references}" prefix="" link_prefix="" base_link_name="link7" reflect_include_reference_points="${[]}" />
</robot>
