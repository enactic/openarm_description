<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find openarm_description)/assets/common/validation.xacro" />

  <xacro:macro name="openarm_control_parameters" params="values index:=0">
    <xacro:property name="keys" value="${list(values.keys())}" />
    <xacro:if value="${index &lt; len(keys)}">
      <param name="${keys[index]}">${values[keys[index]]}</param>
      <xacro:openarm_control_parameters values="${values}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="openarm_control_interfaces" params="kind names index:=0">
    <xacro:if value="${index &lt; len(names)}">
      <xacro:element xacro:name="${kind}">
        <xacro:attribute name="name" value="${names[index]}" />
        <xacro:if value="${kind == 'state_interface'}">
          <param name="initial_value">0.0</param>
        </xacro:if>
      </xacro:element>
      <xacro:openarm_control_interfaces kind="${kind}" names="${names}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="openarm_control_joints" params="joint_names joint_indices command_interfaces state_interfaces index:=0">
    <xacro:if value="${index &lt; len(joint_names)}">
      <joint name="${joint_names[index]}">
        <param name="idx">${joint_indices[index]}</param>
        <xacro:openarm_control_interfaces kind="command_interface" names="${command_interfaces}" />
        <xacro:openarm_control_interfaces kind="state_interface" names="${state_interfaces}" />
      </joint>
      <xacro:openarm_control_joints joint_names="${joint_names}" joint_indices="${joint_indices}" command_interfaces="${command_interfaces}"
        state_interfaces="${state_interfaces}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="openarm_arm_control_parameters" params="description ee_type arm_type out_name">
    <xacro:property name="gains" value="${xacro.load_yaml(description['config_root'] + '/control/control_gains.yaml')}" lazy_eval="false" />
    <xacro:property name="prefix" value="${description['prefix']}" />
    <xacro:property name="parameters"
      value="${dict(arm_type=arm_type, arm_prefix=prefix[8:] if prefix.startswith('openarm_') else prefix, hand=ee_type != '', ee_type=ee_type)}" lazy_eval="false" />
    <xacro:property name="gain_parameters"
      value="${dict([(kind + str(index), gains['joint' + str(index)][kind]) for kind in ['kp', 'kd'] for index in [1, 2, 3, 4, 5, 6, 7]])}" lazy_eval="false" />
    <xacro:property name="parameters" value="${dict(parameters, **gain_parameters)}" lazy_eval="false" />
    <xacro:if value="${ee_type != '' and 'hand' in gains}">
      <xacro:property name="parameters" value="${dict(parameters, kp_hand=gains['hand']['kp'], kd_hand=gains['hand']['kd'])}" lazy_eval="false" />
    </xacro:if>
    <xacro:property name="${out_name}" value="${parameters}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="openarm_ros2_control"
    params="robot_preset component_descriptions arm_type:=v20 use_fake_hardware:=true fake_sensor_commands:=false hardware_defaults:=${dict()} hardware_overrides:=${dict()} index:=0 claimed_joints:=${[]}">
    <xacro:property name="systems" value="${robot_preset.get('systems', dict())}" lazy_eval="false" />
    <xacro:property name="system_names" value="${list(systems)}" lazy_eval="false" />
    <xacro:if value="${index &lt; len(system_names)}">
      <xacro:property name="system_name" value="${system_names[index]}" lazy_eval="false" />
      <xacro:property name="control" value="${dict(hardware_defaults.get(system_name, dict()), **systems[system_name])}" lazy_eval="false" />
      <xacro:property name="control" value="${dict(control, **hardware_overrides.get(system_name, dict()))}" lazy_eval="false" />
      <xacro:property name="selection" value="${control['joints']}" lazy_eval="false" />
      <xacro:openarm_require condition="${python.all(name in robot_preset['robot']['components'] for name in selection)}"
        message="${'System `%s` references an unknown component.' % system_name}" />
      <xacro:property name="components" value="${[name for name in selection if name in component_descriptions and selection[name]]}" lazy_eval="false" />
      <xacro:property name="bindings" value="${[(name, joint) for name in components for joint in selection[name]]}" lazy_eval="false" />
      <xacro:openarm_require condition="${python.all(joint in component_descriptions[name]['topology']['joints'] for name, joint in bindings)}"
        message="${'System `%s` references an unknown joint.' % system_name}" />
      <xacro:property name="command_interfaces" value="${control.get('command_interfaces', ['position', 'velocity', 'effort'])}" lazy_eval="false" />
      <xacro:property name="state_interfaces" value="${control.get('state_interfaces', ['position', 'velocity', 'effort'])}" lazy_eval="false" />
      <xacro:openarm_require condition="${command_interfaces or state_interfaces}"
        message="${'System `%s` must expose at least one interface.' % system_name}" />
      <xacro:openarm_require condition="${not command_interfaces or python.all(component_descriptions[name]['topology']['joints'][joint]['type'] != 'fixed' and joint not in component_descriptions[name]['joint_mimics'] for name, joint in bindings)}"
        message="${'System `%s` assigns commands to a fixed or mimic joint.' % system_name}" />
      <xacro:property name="indices" value="${[selection[name][joint].get('idx') for name, joint in bindings]}" lazy_eval="false" />
      <xacro:openarm_require condition="${python.all(python.type(idx) == int and idx &gt;= 0 for idx in indices)}"
        message="${'System `%s` requires a non-negative integer idx for each joint.' % system_name}" />
      <xacro:openarm_require condition="${len(python.set(indices)) == len(indices)}"
        message="${'System `%s` contains duplicate idx values.' % system_name}" />
      <xacro:property name="ordered_bindings" value="${python.sorted([(selection[name][joint]['idx'], name, joint) for name, joint in bindings])}" lazy_eval="false" />
      <xacro:property name="joint_names" value="${[component_descriptions[name]['prefix'] + joint for idx, name, joint in ordered_bindings]}" lazy_eval="false" />
      <xacro:property name="joint_indices" value="${[idx for idx, name, joint in ordered_bindings]}" lazy_eval="false" />
      <xacro:openarm_require condition="${len(python.set(joint_names)) == len(joint_names) and python.all(name not in claimed_joints for name in joint_names)}"
        message="${'System `%s` contains a duplicate joint assignment.' % system_name}" />
      <xacro:if value="${joint_names}">
        <xacro:property name="parameters" value="${dict()}" lazy_eval="false" />
        <xacro:property name="plugin" value="${control.get('hardware_plugin', '')}" lazy_eval="false" />
        <xacro:if value="${use_fake_hardware}">
          <xacro:property name="plugin" value="mock_components/GenericSystem" />
          <xacro:property name="parameters" value="${dict(mock_sensor_commands=fake_sensor_commands, position_state_following_offset=0.0)}" lazy_eval="false" />
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <xacro:openarm_require condition="${plugin != ''}" message="${'Configure hardware_plugin for system `%s`.' % system_name}" />
          <xacro:if value="${plugin == 'openarm_hardware/OpenArmHW'}">
            <xacro:property name="arms" value="${[name for name in components if component_descriptions[name]['component_type'] == 'arm']}" lazy_eval="false" />
            <xacro:property name="grippers" value="${[name for name in components if component_descriptions[name]['component_type'] == 'end_effector']}" lazy_eval="false" />
            <xacro:openarm_require condition="${len(arms) == 1 and len(selection[arms[0]]) == 7 and len(grippers) &lt;= 1 and (not grippers or len(selection[grippers[0]]) == 1) and len(components) == len(arms) + len(grippers)}"
              message="${'OpenArmHW system `%s` requires seven arm joints and at most one active gripper joint.' % system_name}" />
            <xacro:openarm_require condition="${'can_interface' in control}" message="${'Configure can_interface for system `%s`.' % system_name}" />
            <xacro:property name="ee_type" value="${component_descriptions[grippers[0]]['product'] if grippers else ''}" lazy_eval="false" />
            <xacro:openarm_arm_control_parameters description="${component_descriptions[arms[0]]}" ee_type="${ee_type}" arm_type="${arm_type}" out_name="parameters" />
          </xacro:if>
        </xacro:unless>
        <xacro:property name="configured_parameters" value="${dict([(key, value) for key, value in control.items() if key not in ['hardware_plugin', 'joints', 'command_interfaces', 'state_interfaces']])}" lazy_eval="false" />
        <xacro:property name="parameters" value="${dict(parameters, **configured_parameters)}" lazy_eval="false" />
        <ros2_control name="${system_name}" type="system">
          <hardware>
            <plugin>${plugin}</plugin>
            <xacro:openarm_control_parameters values="${parameters}" />
          </hardware>
          <xacro:openarm_control_joints joint_names="${joint_names}" joint_indices="${joint_indices}" command_interfaces="${command_interfaces}" state_interfaces="${state_interfaces}" />
        </ros2_control>
      </xacro:if>
      <xacro:openarm_ros2_control robot_preset="${robot_preset}" component_descriptions="${component_descriptions}"
        arm_type="${arm_type}" use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}"
        hardware_defaults="${hardware_defaults}" hardware_overrides="${hardware_overrides}" index="${index + 1}" claimed_joints="${claimed_joints + joint_names}" />
    </xacro:if>
  </xacro:macro>
</robot>
