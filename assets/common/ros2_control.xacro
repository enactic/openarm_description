<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find openarm_description)/assets/common/validation.xacro" />

  <xacro:macro name="openarm_control_parameters" params="values index:=0">
    <xacro:property name="keys" value="${list(values.keys())}" />
    <xacro:if value="${index &lt; len(keys)}">
      <param name="${keys[index]}">${values[keys[index]]}</param>
      <xacro:openarm_control_parameters values="${values}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="openarm_control_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="openarm_control_joints" params="joint_names index:=0">
    <xacro:if value="${index &lt; len(joint_names)}">
      <xacro:openarm_control_joint joint_name="${joint_names[index]}" />
      <xacro:openarm_control_joints joint_names="${joint_names}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="openarm_control_joint_names" params="description out_name">
    <xacro:property name="${out_name}"
      value="${[description['prefix'] + name for name, joint in description['topology']['joints'].items() if joint['type'] != 'fixed' and name not in description['joint_mimics']]}"
      scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="openarm_arm_control_parameters" params="description ee_type arm_type out_name">
    <xacro:property name="gains" value="${xacro.load_yaml(description['config_root'] + '/control/control_gains.yaml')}" lazy_eval="false" />
    <xacro:property name="prefix" value="${description['prefix']}" />
    <xacro:property name="parameters"
      value="${dict(arm_type=arm_type, arm_prefix=prefix[8:] if prefix.startswith('openarm_') else prefix, hand=ee_type != '', ee_type=ee_type)}" lazy_eval="false" />
    <xacro:property name="gain_parameters"
      value="${dict([(kind + str(index), gains['joint' + str(index)][kind]) for kind in ['kp', 'kd'] for index in [1, 2, 3, 4, 5, 6, 7]])}" lazy_eval="false" />
    <xacro:property name="parameters" value="${dict(parameters, **gain_parameters)}" lazy_eval="false" />
    <xacro:if value="${ee_type != '' and 'hand' in gains}">
      <xacro:property name="parameters" value="${dict(parameters, kp_hand=gains['hand']['kp'], kd_hand=gains['hand']['kd'])}" lazy_eval="false" />
    </xacro:if>
    <xacro:property name="${out_name}" value="${parameters}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="openarm_ros2_control"
    params="robot_preset component_descriptions arm_type:=v20 use_fake_hardware:=true fake_sensor_commands:=false hardware_overrides:=${dict()} index:=0">
    <xacro:property name="components" value="${list(component_descriptions)}" lazy_eval="false" />
    <xacro:if value="${index &lt; len(components)}">
      <xacro:property name="name" value="${components[index]}" lazy_eval="false" />
      <xacro:property name="component" value="${robot_preset[name]}" lazy_eval="false" />
      <xacro:if value="${'control' in component}">
        <xacro:property name="control" value="${component['control']}" lazy_eval="false" />
        <xacro:property name="description" value="${component_descriptions[name]}" lazy_eval="false" />
        <xacro:openarm_require condition="${'side' not in control and 'parameters' not in control}"
          message="${'Component `%s` requires flat control settings, including can_interface for OpenArm hardware.' % name}" />
        <xacro:property name="system_name" value="${control.get('system_name', name + '_hardware_interface')}" lazy_eval="false" />
        <xacro:property name="control" value="${dict(control, **hardware_overrides.get(system_name, dict()))}" lazy_eval="false" />
        <xacro:property name="controlled_components" value="${[key for key in components if 'control' in robot_preset[key]]}" lazy_eval="false" />
        <xacro:openarm_require condition="${len([key for key in controlled_components if robot_preset[key]['control'].get('system_name', key + '_hardware_interface') == system_name]) == 1}"
          message="${'Duplicate control system name `%s`.' % system_name}" />
        <xacro:openarm_control_joint_names description="${description}" out_name="joint_names" />
        <xacro:property name="ee_type" value="${''}" lazy_eval="false" />
        <xacro:if value="${description['component_type'] == 'arm'}">
          <xacro:property name="grippers"
            value="${[key for key in components if component_descriptions[key]['component_type'] == 'end_effector' and robot_preset[key].get('connection', dict()).get('attach_to') == name and 'control' not in robot_preset[key]]}" lazy_eval="false" />
          <xacro:openarm_require condition="${len(grippers) &lt;= 1}" message="${'Arm `%s` supports one attached gripper in its control system.' % name}" />
          <xacro:if value="${grippers}">
            <xacro:property name="gripper" value="${component_descriptions[grippers[0]]}" lazy_eval="false" />
            <xacro:openarm_control_joint_names description="${gripper}" out_name="gripper_joint_names" />
            <xacro:property name="joint_names" value="${joint_names + gripper_joint_names}" lazy_eval="false" />
            <xacro:property name="ee_type" value="${gripper['product']}" lazy_eval="false" />
          </xacro:if>
        </xacro:if>
        <xacro:property name="parameters" value="${dict()}" lazy_eval="false" />
        <xacro:property name="plugin" value="${control.get('hardware_plugin', '')}" lazy_eval="false" />
        <xacro:if value="${use_fake_hardware}">
          <xacro:property name="plugin" value="mock_components/GenericSystem" />
          <xacro:property name="parameters" value="${dict(mock_sensor_commands=fake_sensor_commands, position_state_following_offset=0.0)}" lazy_eval="false" />
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <xacro:openarm_require condition="${plugin != ''}" message="${'Configure control.hardware_plugin on `%s` for real hardware.' % name}" />
          <xacro:if value="${plugin == 'openarm_hardware/OpenArmHW'}">
            <xacro:openarm_require condition="${'can_interface' in control}" message="${'Configure control.can_interface on `%s`.' % name}" />
            <xacro:openarm_arm_control_parameters description="${description}" ee_type="${ee_type}" arm_type="${arm_type}" out_name="parameters" />
          </xacro:if>
        </xacro:unless>
        <xacro:property name="configured_parameters" value="${dict([(key, value) for key, value in control.items() if key not in ['system_name', 'hardware_plugin']])}" lazy_eval="false" />
        <xacro:property name="parameters" value="${dict(parameters, **configured_parameters)}" lazy_eval="false" />
        <ros2_control name="${system_name}" type="system">
          <hardware>
            <plugin>${plugin}</plugin>
            <xacro:openarm_control_parameters values="${parameters}" />
          </hardware>
          <xacro:openarm_control_joints joint_names="${joint_names}" />
        </ros2_control>
      </xacro:if>
      <xacro:openarm_ros2_control robot_preset="${robot_preset}" component_descriptions="${component_descriptions}"
        arm_type="${arm_type}" use_fake_hardware="${use_fake_hardware}" fake_sensor_commands="${fake_sensor_commands}" hardware_overrides="${hardware_overrides}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>
</robot>
