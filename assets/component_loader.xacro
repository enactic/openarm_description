<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find openarm_description)/assets/common/assembly.xacro" />

  <xacro:macro name="openarm_resolve_component_paths" params="component_cfg out_name">
    <xacro:property name="kind" value="${component_cfg['type']}" />
    <xacro:property name="config" value="${component_cfg['config']}" />
    <xacro:property name="component_dir" value="${'$(find openarm_description)/assets/' + kind + '/' + component_cfg['product'] + ('/' + config if kind == 'end_effector' and config != None else '')}" />
    <xacro:property name="${out_name}"
      value="${dict(component_dir=component_dir, config_root=component_dir + '/config' + ('/' + config if kind == 'robot' else ''), interface=component_dir + '/urdf/component.xacro')}"
      scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="openarm_describe_auto_component"
    params="component_name component_cfg options out_name config_root_override:=''">
    <xacro:macro name="describe_component" params="component_name component_cfg config_root options out_name">
      <xacro:openarm_describe_config_component component_name="${component_name}" component_cfg="${component_cfg}" config_root="${config_root}" options="${options}" out_name="description" />
      <xacro:property name="${out_name}" value="${description}" scope="parent" lazy_eval="false" />
    </xacro:macro>
    <xacro:openarm_resolve_component_paths component_cfg="${component_cfg}" out_name="component_paths" />
    <xacro:include filename="${component_paths['interface']}" optional="true" />
    <xacro:describe_component component_name="${component_name}" component_cfg="${component_cfg}"
      config_root="${config_root_override or component_paths['config_root']}" options="${options}" out_name="loaded_description" />
    <xacro:property name="${out_name}" value="${dict(loaded_description, component_dir=component_paths['component_dir'])}" scope="parent" lazy_eval="false" />
  </xacro:macro>

  <xacro:macro name="openarm_emit_auto_component" params="component_desc component_runtime options">
    <xacro:macro name="emit_component" params="component_desc component_runtime options">
      <xacro:openarm_emit_config_component component_desc="${component_desc}" component_runtime="${component_runtime}" options="${options}" />
    </xacro:macro>
    <xacro:include filename="${component_desc['component_dir'] + '/urdf/component.xacro'}" optional="true" />
    <xacro:emit_component component_desc="${component_desc}" component_runtime="${component_runtime}" options="${options}" />
  </xacro:macro>

  <xacro:macro name="openarm_emit_standalone_component" params="component_cfg component_desc options:=${dict()} root_frame:=world">
    <xacro:property name="component_api" value="${dict(describe='openarm_describe_auto_component', emit='openarm_emit_auto_component')}" />
    <xacro:property name="preset" value="${dict(component=component_cfg)}" />
    <xacro:openarm_validate_robot_preset components="${['component']}" robot_preset="${preset}" />
    <link name="${root_frame}" />
    <xacro:openarm_resolve_component_runtime component_name="component" components="${['component']}"
      robot_preset="${preset}" config_root="${component_desc['config_root']}" root_frame="${root_frame}"
      component_cfg="${component_cfg}" component_desc="${component_desc}" component_api="${component_api}" out_name="component_runtime" />
    <xacro:openarm_emit_auto_component component_desc="${component_desc}" component_runtime="${component_runtime}" options="${options}" />
  </xacro:macro>
</robot>
