<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm">

  <xacro:include filename="$(find openarm_description)/assets/common/robot.xacro" />

  <xacro:arg name="robot_preset" default="v2/default_bimanual" />
  <xacro:arg name="emit_grasp_frame" default="false" />

  <xacro:arg name="ros2_control" default="true" />
  <xacro:arg name="fake_sensor_commands" default="false" />
  <xacro:arg name="use_fake_hardware" default="true" />
  <xacro:arg name="can_interface" default="" />
  <xacro:arg name="left_can_interface" default="" />
  <xacro:arg name="right_can_interface" default="" />
  <xacro:arg name="can_fd" default="" />

  <xacro:openarm_robot robot_preset="$(arg robot_preset)"
    emit_grasp_frame="$(arg emit_grasp_frame)"
    ros2_control="$(arg ros2_control)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    can_interface="$(arg can_interface)"
    left_can_interface="$(arg left_can_interface)"
    right_can_interface="$(arg right_can_interface)"
    can_fd="$(arg can_fd)" />

</robot>
